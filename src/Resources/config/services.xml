<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Nova\TwoFactor\Service\SecretCipher">
            <argument>%kernel.secret%</argument>
        </service>

        <service id="Nova\TwoFactor\Service\TwoFactorStore">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Nova\TwoFactor\Service\SecretCipher"/>
        </service>

        <!-- Admin-Benutzer: eigene Tabelle -->
        <service id="nova_two_factor.user_store" class="Nova\TwoFactor\Service\TwoFactorStore">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Nova\TwoFactor\Service\SecretCipher"/>
            <argument>nova_two_factor_user</argument>
            <argument>user_id</argument>
        </service>

        <service id="Nova\TwoFactor\Subscriber\AdminLoginSubscriber">
            <argument type="service" id="nova_two_factor.user_store"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <call method="setRateLimiter">
                <argument type="service" id="shopware.rate_limiter" on-invalid="null"/>
            </call>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\TwoFactor\Subscriber\AdminGuardSubscriber">
            <argument type="service" id="nova_two_factor.user_store"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="cache.object"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\TwoFactor\Subscriber\AccessWriteGuardSubscriber">
            <argument type="service" id="Nova\TwoFactor\Subscriber\AdminGuardSubscriber"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\TwoFactor\Command\ResetUserCommand">
            <argument type="service" id="nova_two_factor.user_store"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="console.command"/>
        </service>

        <!-- Öffentlich: andere Plugins (z. B. Nova Upload) fragen hier, ob die 2FA bestätigt ist -->
        <service id="Nova\TwoFactor\Service\TwoFactorGuard" public="true">
            <argument type="service" id="Nova\TwoFactor\Service\TwoFactorStore"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Nova\TwoFactor\Subscriber\TwoFactorGateSubscriber">
            <argument type="service" id="Nova\TwoFactor\Service\TwoFactorGuard"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="router"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\TwoFactor\Controller\TwoFactorController" public="true">
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader"/>
            <argument type="service" id="Nova\TwoFactor\Service\TwoFactorStore"/>
            <argument type="service" id="Nova\TwoFactor\Service\TwoFactorGuard"/>
            <argument type="service" id="Nova\TwoFactor\Service\SecretCipher"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Nova\TwoFactor\Controller\AdminTwoFactorController" public="true">
            <argument type="service" id="Nova\TwoFactor\Service\TwoFactorStore"/>
            <argument type="service" id="nova_two_factor.user_store"/>
            <argument type="service" id="Nova\TwoFactor\Service\SecretCipher"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <call method="setLogger">
                <argument type="service" id="logger" on-invalid="null"/>
            </call>
        </service>
    </services>
</container>
